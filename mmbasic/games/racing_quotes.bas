' a line for the moment cat$, with the %N %C ... filled in
Function Quote$(cat$)
  Local string c$, t$
  Local integer n, i, k, r
  Restore QuoteBank
  Do
    Read c$, n
    If c$ = "END" Then Exit Function
    If c$ = cat$ Then
      ' shuffle bag: every line said once before any repeat (qSaid, one
      ' bit per line), and never immediately the same one as last time
      ' even across a reshuffle (qLast holds that line + 1). Once every
      ' line's bit is set the bag's empty -- clear it and start again
      If (qSaid(k) And ((1 << n) - 1)) = (1 << n) - 1 Then qSaid(k) = 0
      Do
        r = Int(Rnd * n)
      Loop While n > 1 And ((qSaid(k) And (1 << r)) <> 0 Or r = qLast(k) - 1)
      qSaid(k) = qSaid(k) Or (1 << r)
      qLast(k) = r + 1
      For i = 0 To r
        Read t$
      Next
      Quote$ = FillIn$(t$)
      Exit Function
    EndIf
    For i = 1 To n
      Read t$
    Next
    k = k + 1
  Loop
End Function

' t$ with its %N %C %D %M %T %X %E filled in -- one pass, two small
' strings (the PICO3's string heap is small, and this runs while a
' scene is already holding its lines)
Function FillIn$(t$)
  Local string o$, k$
  Local integer i
  i = 1
  Do While i <= Len(t$)
    k$ = Mid$(t$, i, 1)
    If k$ = "%" And i < Len(t$) Then
      k$ = Mid$(t$, i + 1, 1)
      i = i + 2
      Select Case k$
        Case "N"
          o$ = o$ + qN$
        Case "C"
          o$ = o$ + qC$
        Case "D"
          o$ = o$ + qD$
        Case "M"
          o$ = o$ + qM$
        Case "T"
          o$ = o$ + qT$
        Case "X"
          o$ = o$ + qX$
        Case "E"
          o$ = o$ + qE$
        Case "P"
          o$ = o$ + qP$
        Case Else
          ' a plain % (as in "45% damage"): keep it, and the next letter
          o$ = o$ + "%"
          i = i - 1
      End Select
    Else
      o$ = o$ + k$
      i = i + 1
    EndIf
  Loop
  FillIn$ = o$
End Function
